{# Postal+ — Adicionar objetos (individual grava e consulta; lote só classifica). Variáveis: nav, tela #}
{% set f = tela.form %}
<div class="postalplus pp-pagina container-fluid py-3" data-pp-tela="adicionar">
    {% include '@postalplus/_nav.html.twig' with {
        nav: nav,
        titulo: 'Adicionar objetos',
        subtitulo: 'Cadastre um envio ou importe vários de uma vez. Cada objeto é consultado na API assim que é salvo.'
    } only %}

    <script type="application/json" id="pp-codigos-existentes">{{ tela.codigos_json|raw }}</script>

    {% if tela.erros|length > 0 %}
        <div class="alert alert-danger" role="alert" data-pp-erros="{{ tela.erros|length }}">
            <div>
                <div class="fw-semibold mb-1">O objeto não foi gravado:</div>
                <ul class="mb-0">{% for e in tela.erros %}<li>{{ e }}</li>{% endfor %}</ul>
            </div>
        </div>
    {% endif %}

    <div class="row g-3">
        <div class="col-xl-6">
            <form class="card pp-card" method="post" action="{{ nav.web }}/front/adicionar.php" id="pp-form-individual" novalidate>
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <div class="card-header"><h3 class="card-title">Objeto individual</h3></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label required" for="pp-codigo">Código de rastreio</label>
                        <input class="form-control font-monospace text-uppercase" id="pp-codigo" name="codigo" maxlength="20" placeholder="AA123456789BR" autocomplete="off" value="{{ f.codigo }}" required>
                        <div class="small mt-1" id="pp-codigo-status" aria-live="polite"></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="pp-servico">Serviço</label>
                            <select class="form-select" id="pp-servico" name="servico">
                                <option value="" {{ f.servico == '' ? 'selected' : '' }}>Detectar pela API</option>
                                {% for s in tela.servicos %}<option value="{{ s }}" {{ s == f.servico ? 'selected' : '' }}>{{ s }}</option>{% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pp-data">Data de postagem</label>
                            <input class="form-control" type="date" id="pp-data" name="data_postagem" value="{{ f.data_postagem }}">
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="pp-dest">Destinatário</label>
                            <input class="form-control" id="pp-dest" name="destinatario_nome" maxlength="255" placeholder="Cliente ou empresa que recebe" value="{{ f.destinatario_nome }}">
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="pp-contato">Responsável pelo recebimento</label>
                            <input class="form-control" id="pp-contato" name="destinatario_contato" maxlength="255" placeholder="Pessoa de contato no cliente" value="{{ f.destinatario_contato }}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pp-whatsapp">WhatsApp do responsável</label>
                            <input class="form-control" id="pp-whatsapp" name="destinatario_whatsapp" maxlength="30" placeholder="(00) 00000-0000" inputmode="tel" value="{{ f.destinatario_whatsapp }}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pp-email">E-mail do responsável</label>
                            <input class="form-control" type="email" id="pp-email" name="destinatario_email" maxlength="255" placeholder="opcional" value="{{ f.destinatario_email }}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pp-cidade">Cidade / UF</label>
                            <input class="form-control" id="pp-cidade" name="destinatario_cidade" maxlength="255" placeholder="Ex.: Londrina/PR" value="{{ f.destinatario_cidade }}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pp-chamado">Chamado vinculado</label>
                            <input class="form-control" id="pp-chamado" name="tickets_id" inputmode="numeric" maxlength="12" placeholder="Nº do chamado (opcional)" value="{{ f.tickets_id }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="pp-entidade">Entidade</label>
                            <select class="form-select" id="pp-entidade" name="entities_id">
                                {% for e in tela.entidades %}<option value="{{ e.id }}" {{ e.id == f.entities_id ? 'selected' : '' }}>{{ e.nome }}</option>{% endfor %}
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Responsável</label>
                            <div data-pp-dd="usuario">{{ tela.dd_usuario|raw }}</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Grupo</label>
                            <div data-pp-dd="grupo">{{ tela.dd_grupo|raw }}</div>
                        </div>
                    </div>
                    <label class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" name="avisar_whatsapp" value="1" id="pp-avisar" {{ f.avisar_whatsapp ? 'checked' : '' }}>
                        <span class="form-check-label">Avisar o responsável pelo recebimento por WhatsApp nos eventos-chave (saiu para entrega, aguardando retirada)</span>
                    </label>
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="abrir_chamado" value="1" {{ f.abrir_chamado ? 'checked' : '' }}>
                        <span class="form-check-label">Abrir chamado automaticamente se houver alerta crítico</span>
                    </label>
                </div>
                <div class="card-footer d-flex justify-content-end align-items-center gap-2">
                    <a class="btn btn-outline-secondary" href="{{ nav.web }}/front/painel.php">Cancelar</a>
                    <button type="submit" class="btn btn-primary" name="salvar_individual" value="1" id="pp-salvar">Salvar e consultar agora</button>
                </div>
            </form>
        </div>

        <div class="col-xl-6">
            <div class="card pp-card">
                <div class="card-header"><h3 class="card-title">Importação em lote</h3></div>
                <div class="card-body">
                    {% include '@postalplus/_demo.html.twig' with {
                        texto: 'A classificação dos códigos já funciona, mas a importação em lote só grava no Bloco 10.'
                    } only %}
                    <ul class="nav nav-pills mb-3" role="tablist">
                        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#pp-lote-colar" role="tab">Colar códigos</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#pp-lote-csv" role="tab">Arquivo CSV</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#pp-lote-ro" role="tab">Relatório de Objetos (RO)</a></li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane active show" id="pp-lote-colar" role="tabpanel">
                            <label class="form-label" for="pp-lote">Um código por linha (ou separados por vírgula)</label>
                            <textarea class="form-control font-monospace" id="pp-lote" rows="6" placeholder="QP303012777BR&#10;OY994410382BR"></textarea>
                            <div class="d-flex flex-wrap gap-2 my-2" id="pp-lote-resumo"></div>
                            <div class="pp-lote-lista d-none" id="pp-lote-lista"></div>
                        </div>
                        <div class="tab-pane" id="pp-lote-csv" role="tabpanel">
                            <div class="text-secondary">Importar planilha CSV (código, destinatário, WhatsApp, cidade, chamado) — Bloco 10.</div>
                        </div>
                        <div class="tab-pane" id="pp-lote-ro" role="tabpanel">
                            <div class="text-secondary">Importar o Relatório de Objetos exportado do contrato — Bloco 10.</div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label">Serviço padrão</label>
                            <select class="form-select"><option>Detectar pela API</option>{% for s in tela.servicos %}<option>{{ s }}</option>{% endfor %}</select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Responsável</label>
                            <select class="form-select">
                                <option value="u{{ tela.usuario.id }}">{{ tela.usuario.nome }}</option>
                                {% for g in tela.grupos %}<option value="g{{ g.id }}">Grupo {{ g.nome }}</option>{% endfor %}
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <button type="button" class="btn btn-primary" id="pp-importar" disabled title="Importação chega no Bloco 10">Importar 0 objeto(s) válido(s)</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="{{ nav.web }}/js/adicionar.js?v={{ nav.v }}"></script>
