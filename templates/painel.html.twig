{# Postal+ — Painel (Bloco 2: objetos reais + demonstração). Variáveis: nav, tela #}
<div class="postalplus pp-pagina container-fluid py-3" data-pp-tela="painel">
    {% include '@postalplus/_nav.html.twig' with {
        nav: nav,
        titulo: 'Painel de rastreio',
        subtitulo: 'Objetos postados pelo contrato · atualizados automaticamente pela API Rastro dos Correios'
    } only %}

    {% include '@postalplus/_demo.html.twig' with {
        texto: 'Os objetos marcados “demo” são do mockup e saem no Bloco 5. Os que você cadastrar aparecem no topo, como “Não consultado” até o Bloco 3.'
    } only %}

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="input-icon pp-busca">
            <span class="input-icon-addon"><i class="ti ti-search"></i></span>
            <input type="search" class="form-control" id="pp-busca" placeholder="Código, destinatário ou chamado" aria-label="Buscar">
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled title="Chega com o cliente da API Rastro (Bloco 3)">
            <i class="ti ti-refresh me-1"></i>Consultar agora
        </button>
        {% if tela.pode_criar %}
            <a class="btn btn-primary" href="{{ tela.url_add }}"><i class="ti ti-plus me-1"></i>Adicionar objetos</a>
        {% endif %}
        <span class="badge bg-secondary-lt ms-auto" title="A consulta automática entra no Bloco 4">
            <i class="ti ti-player-pause me-1"></i>Monitoramento ainda não ativo
        </span>
    </div>

    <div class="row g-2 mb-3" id="pp-cards">
        {% for chave, card in tela.cards %}
            <div class="col-6 col-md-4 col-xl-2">
                <button type="button" class="pp-kpi" data-pp-card="{{ chave }}" aria-pressed="false">
                    <span class="pp-st pp-st-{{ card.classe }}">{{ card.rotulo }}</span>
                    <div class="pp-kpi-num" data-pp-total="{{ chave }}">{{ tela.totais[chave] }}</div>
                    <div class="pp-kpi-desc">{{ card.desc }}</div>
                </button>
            </div>
        {% endfor %}
    </div>

    <div class="card pp-card">
        <div class="card-header">
            <h3 class="card-title">
                <span id="pp-titulo-lista">Todos os objetos em acompanhamento</span>
                <span class="text-secondary fw-normal">· <span id="pp-qtd">{{ tela.objetos|length }}</span> objeto(s)</span>
            </h3>
            <button type="button" class="btn btn-sm btn-ghost-secondary ms-auto d-none" id="pp-limpar">Limpar filtro</button>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table pp-tabela">
                <thead>
                <tr>
                    <th>Código</th><th>Status</th><th>Último evento</th><th>Atualizado</th>
                    <th>Prazo / alerta</th><th>Destinatário</th><th>Chamado</th>
                </tr>
                </thead>
                <tbody>
                {% for o in tela.objetos %}
                    <tr data-pp-linha data-card="{{ o.card }}"
                        data-pp-origem="{{ o.demo ? 'demo' : 'real' }}"
                        data-busca="{{ (o.codigo ~ ' ' ~ o.destinatario ~ ' ' ~ o.contato ~ ' ' ~ o.cidade ~ ' ' ~ (o.chamado ? '#' ~ o.chamado : ''))|lower }}">
                        <td>
                            <a class="pp-codigo" href="{{ tela.url_objeto ~ o.codigo }}">{{ o.codigo }}</a>
                            <div class="pp-sub">{% if o.demo %}<span class="badge bg-secondary-lt me-1">demo</span>{% endif %}{{ o.servico }}</div>
                        </td>
                        <td><span class="pp-st pp-st-{{ o.situacao }}">{{ o.rotulo }}</span></td>
                        <td>{{ o.evento }}<div class="pp-sub">{{ o.local }}</div></td>
                        <td class="text-nowrap">{{ o.atualizado }}</td>
                        <td class="{{ o.alerta_nivel ? 'pp-alerta-' ~ o.alerta_nivel : 'text-secondary' }}">{{ o.alerta }}</td>
                        <td>{{ o.destinatario }}{% if o.contato %}<div class="pp-sub" data-pp-contato><i class="ti ti-user"></i> {{ o.contato }}</div>{% endif %}<div class="pp-sub">{{ o.cidade }}</div></td>
                        <td>{% if o.chamado %}<a href="{{ tela.url_ticket ~ o.chamado }}">#{{ o.chamado }}</a>{% else %}<span class="text-secondary">—</span>{% endif %}</td>
                    </tr>
                {% endfor %}
                <tr id="pp-vazio" class="d-none"><td colspan="7" class="text-center text-secondary py-4">Nenhum objeto encontrado.</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="pp-toasts" id="pp-toasts" aria-live="polite">
        {% for t in tela.toasts %}
            <div class="pp-toast" data-pp-toast>
                <div class="pp-toast-icone {{ t.nivel }}"><i class="{{ t.icone }}"></i></div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">{{ t.titulo }} <span class="badge bg-secondary-lt ms-1">demo</span></div>
                    <div>{{ t.texto }}</div>
                    <a class="small" href="{{ tela.url_objeto ~ t.codigo }}">Ver objeto</a>
                </div>
                <button type="button" class="btn-close" aria-label="Fechar" data-pp-fechar></button>
            </div>
        {% endfor %}
    </div>
</div>
<script src="{{ nav.web }}/js/painel.js?v={{ nav.v }}"></script>
